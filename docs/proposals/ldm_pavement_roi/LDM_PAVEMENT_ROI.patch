+# ---------------------------------------------------------------------- 3. exclusion zones
+def test_detection_inside_exclusion_zone_is_rejected_even_when_in_pavement_tolerance():
+    d = det(REAL_COUNTER_PIECE, 0.72, "plastic_piece")
