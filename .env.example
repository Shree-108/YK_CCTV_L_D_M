# Copy to .env (gitignored). Never commit real secrets.
#
# Public server (EC2): the browser reaches the app at http://<server>/ldm and the API at /ldm-api on the same address
# (Nginx: deploy/nginx/yk-cctv.conf), so no API URL or CORS setting is needed.
#
# Login (on by default). Every API route needs a signed-in role: viewer (read), operator (+ detection, alert review),
# admin (+ setup, CSV exports, diagnostics). Create the admin once:
#   .venv/bin/python -m backend.auth add-user admin --role admin      (password asked at a hidden prompt)
LM_AUTH_MODE=on
# LM_AUTH_DB_PATH=storage/auth.db           # separate from the detection database; git-ignored (storage/)
# LM_AUTH_IDLE_MINUTES=30                    # session ends after this long without user activity
# LM_AUTH_MAX_SESSION_HOURS=12               # ... and always this long after login
# LM_AUTH_MAX_FAILURES=5                     # failed logins (per username and per client) before a lock-out
# LM_AUTH_LOCKOUT_MINUTES=15
# LM_AUTH_MIN_PASSWORD_LENGTH=12
# LM_AUTH_COOKIE_SECURE=auto                 # auto = Secure flag when served over HTTPS; true / false force it
# Optional bearer token that also acts as an admin (scripts / automation). Leave empty unless you need it.
ADMIN_API_TOKEN=
# Only needed when the dashboard is opened from a different address than the API (not the Nginx setup).
# CORS_ORIGINS=http://localhost:3000
MAX_IMAGE_UPLOAD_MB=25
MAX_VIDEO_UPLOAD_MB=500
# Live RTSP cameras are not opened unless true (a cloud server normally cannot reach the store NVR)
LM_START_CAMERAS=false
# API docs (/docs, /redoc, /openapi.json) are off by default; keep them off on a public server
# LM_ENABLE_API_DOCS=false
# Optional path overrides
# LM_STORAGE_DIR=storage
# LM_MODELS_DIR=models
# LM_DB_PATH=storage/litter_monitor.db
# RTSP URLs with credentials: store here and reference as source "env:CAM01_RTSP_URL"
CAM01_RTSP_URL=
# Live CCTV (NVR). Values come from the authorized CCTV administrator - never commit them.
# Non-secret defaults prefill the Live CCTV form; the RTSP path differs per NVR brand/firmware.
CCTV_HOST=
CCTV_RTSP_PORT=
CCTV_CHANNEL=
CCTV_STREAM_TYPE=          # main | sub
CCTV_USERNAME=
CCTV_PASSWORD=
# CCTV_RTSP_PATH=/cam/realmonitor?channel={channel}&subtype={subtype}
# Per-camera credentials (written here by the Live CCTV page when a password is entered):
# CCTV_<CAMERA_ID>_USERNAME= / CCTV_<CAMERA_ID>_PASSWORD=
# CAMERA_OPEN_TIMEOUT_MS=5000
# CAMERA_READ_TIMEOUT_MS=5000
# Notifications (each provider is enabled only when all its variables are set)
NOTIFY_MIN_SEVERITY=HIGH
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Which Yatrikart AI module this dashboard is (shown under the brand): litter | uniform
# NEXT_PUBLIC_APP_MODULE=litter

# Export-folder ingestion of KVMS recordings (python -m ingest.export_folder; see docs/CCTV_RECORDING_RETRIEVAL.md)
# LDM_EXPORT_DIR=D:\KVMS_Export
# LDM_API_URL=http://127.0.0.1:8000
# LDM_INGEST_DIR=storage/ingest

# ai_garbage_detection import CSV (backend/services/garbage_export.py). Store data: config/store_config.json
# LDM_GARBAGE_EXPORT=off                     # on: export every finished four-screenshot job / video analysis
# LDM_STORE_CONFIG=config/store_config.json
# LDM_GARBAGE_EXPORT_DIR=storage/exports/ai_garbage_detection
# LDM_GARBAGE_EXPORT_LEDGER=storage/exports/ai_garbage_detection_ledger.db
# LDM_TRUST_CONTAINER_TIME=off               # on: MP4 creation time counts as recording start (unverified for NVR exports)

# S3 upload of finished four-screenshot jobs (backend/core/s3.py, backend/services/s3_sync.py). Layout:
#   <bucket>/MM-YYYY/DD-MM-YYYY/cart_<N>/input_data/<video>            (recording day)
#   <bucket>/MM-YYYY/DD-MM-YYYY/cart_<N>/output_data/cart<N>_YYYY_MM_DD.csv + _pic<K>.jpg   (processing day, IST)
# LDM_S3_UPLOAD=off
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# LDM_S3_BUCKET=yk-litter-detection-data
