# Copy to .env (gitignored). Never commit real secrets.
ADMIN_API_TOKEN=            # required for admin endpoints (cameras, settings, models, training); generate a long random value
CORS_ORIGINS=http://localhost:3000
MAX_IMAGE_UPLOAD_MB=25
MAX_VIDEO_UPLOAD_MB=500
LM_START_CAMERAS=true
# Optional path overrides
# LM_STORAGE_DIR=storage
# LM_MODELS_DIR=models
# LM_DB_PATH=storage/litter_monitor.db
# RTSP URLs with credentials: store here and reference as source "env:CAM01_RTSP_URL"
CAM01_RTSP_URL=
# Live CCTV (NVR). Values come from the authorized CCTV administrator - never commit them.
# Non-secret defaults prefill the Live CCTV form; the RTSP path differs per NVR brand/firmware.
CCTV_HOST=
CCTV_RTSP_PORT=
CCTV_CHANNEL=
CCTV_STREAM_TYPE=          # main | sub
CCTV_USERNAME=
CCTV_PASSWORD=
# CCTV_RTSP_PATH=/cam/realmonitor?channel={channel}&subtype={subtype}
# Per-camera credentials (written here by the Live CCTV page when a password is entered):
# CCTV_<CAMERA_ID>_USERNAME= / CCTV_<CAMERA_ID>_PASSWORD=
# CAMERA_OPEN_TIMEOUT_MS=5000
# CAMERA_READ_TIMEOUT_MS=5000
# Notifications (each provider is enabled only when all its variables are set)
NOTIFY_MIN_SEVERITY=HIGH
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
